<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - Uma Musume Bot</title>
  <style>
    body {
      margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: url('https://images.unsplash.com/photo-1554034483-04fda0d3507b?auto=format&fit=crop&q=80') no-repeat center center fixed;
      background-size: cover; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh;
    }
    .glass-card {
      background: rgba(30, 30, 40, 0.85); backdrop-filter: blur(12px); border: 2px solid rgba(136, 255, 0, 0.4);
      border-radius: 20px; padding: 40px; text-align: center; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
    }
    h1 { color: #a8ff78; margin-bottom: 10px; }
    .btn {
      display: inline-block; background: linear-gradient(135deg, #a8ff78 0%, #78ffd6 100%);
      color: #111; font-weight: bold; border: none; padding: 15px 30px; border-radius: 30px;
      text-decoration: none; font-size: 1.1em; transition: transform 0.2s; margin-top: 20px;
    }
    .btn:hover { transform: scale(1.05); }
  </style>
</head>
<body>
  <div class="glass-card">
    <h1>🐎 Uma Musume Bot System</h1>
    <p>Premium Discord Bot for Leveling, Moderation, & Trackers</p>
    <a href="/login" class="btn">Login with Discord</a>
  </div>
</body>
</html>
