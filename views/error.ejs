<!DOCTYPE html>
<html lang="en">
<head>
  <title>Error</title>
  <style>
    body { background: #121212; color: #ff5555; text-align: center; padding: 50px; font-family: sans-serif; }
    .card { background: #1e1e1e; padding: 30px; border-radius: 10px; display: inline-block; border: 1px solid #ff5555; }
    a { color: #fff; text-decoration: none; display: block; margin-top: 20px; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Access Denied / Error</h2>
    <p><%= message %></p>
    <a href="/">Return Home</a>
  </div>
</body>
</html>
