<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Uma Bot</title>
  <style>
    body {
      margin: 0; padding: 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: url('https://images.unsplash.com/photo-1554034483-04fda0d3507b?auto=format&fit=crop&q=80') no-repeat center center fixed;
      background-size: cover; color: #fff;
    }
    .container { max-width: 900px; margin: 0 auto; }
    .glass-panel {
      background: rgba(20, 20, 30, 0.9); backdrop-filter: blur(15px); border: 2px solid rgba(136, 255, 0, 0.5);
      border-radius: 15px; padding: 30px; margin-bottom: 20px; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.6);
    }
    h2, h3 { color: #a8ff78; border-bottom: 1px solid rgba(136, 255, 0, 0.3); padding-bottom: 10px; }
    .form-group { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; font-size: 0.9em; color: #ccc; }
    input[type="text"] {
      width: 100%; padding: 10px; border: 1px solid #444; border-radius: 5px; background: rgba(0,0,0,0.5); color: #fff;
      box-sizing: border-box;
    }
    .btn {
      background: linear-gradient(135deg, #a8ff78 0%, #78ffd6 100%); color: #111; font-weight: bold;
      border: none; padding: 10px 20px; border-radius: 20px; cursor: pointer; transition: transform 0.2s;
    }
    .btn:hover { transform: scale(1.05); }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    select { padding: 10px; border-radius: 5px; background: #222; color: #fff; border: 1px solid #444; }
  </style>
</head>
<body>
  <div class="container">
    <div class="glass-panel" style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h2>🐎 Welcome Trainer, <%= user.username %>!</h2>
        <p>Manage your bot settings efficiently.</p>
      </div>
      <div>
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" style="border-radius: 50%; width: 60px;">
        <br><a href="/logout" style="color: #ff5555; text-decoration: none; font-size: 14px;">Logout</a>
      </div>
    </div>

    <div class="glass-panel">
      <h3>Select Server to Configure</h3>
      <select id="serverSelect" onchange="loadSettings()">
        <option value="">-- Choose a Server --</option>
        <% guilds.forEach(guild => { %>
          <option value="<%= guild.id %>"><%= guild.name %></option>
        <% }) %>
      </select>
    </div>

    <div id="settingsPanel" class="glass-panel" style="display: none;">
      <form id="settingsForm">
        <h3>Channel Settings (Discord Channel IDs)</h3>
        <div class="grid">
          <div class="form-group"><label>Welcome Channel</label><input type="text" id="welcomeChannelId" placeholder="ID"></div>
          <div class="form-group"><label>Announce Channel</label><input type="text" id="announceChannelId" placeholder="ID"></div>
          <div class="form-group"><label>AI Chat Channel</label><input type="text" id="aiChannelId" placeholder="ID"></div>
          <div class="form-group"><label>Minigame Channel</label><input type="text" id="minigameChannelId" placeholder="ID"></div>
        </div>

        <h3>Social Media Trackers (Per Server Configuration)</h3>
        <p style="font-size: 12px; color: #aaa;">Enter the target ID (e.g., YouTube Channel ID, Twitter Username) and the Discord Channel ID to post updates to.</p>
        <div class="grid">
          <div class="form-group"><label>YouTube Channel ID (Target)</label><input type="text" id="ytTrackId" placeholder="UCxxxxx"></div>
          <div class="form-group"><label>YouTube Discord Channel</label><input type="text" id="ytChannelId" placeholder="ID"></div>
          
          <div class="form-group"><label>Twitter Username (Target)</label><input type="text" id="twitterTrackId" placeholder="username"></div>
          <div class="form-group"><label>Twitter Discord Channel</label><input type="text" id="twitterChannelId" placeholder="ID"></div>
          
          <div class="form-group"><label>TikTok Username (Target)</label><input type="text" id="tiktokTrackId" placeholder="@username"></div>
          <div class="form-group"><label>TikTok Discord Channel</label><input type="text" id="tiktokChannelId" placeholder="ID"></div>
        </div>

        <h3>Roles & Auto-Moderation</h3>
        <div class="grid">
          <div class="form-group"><label>Auto Role IDs (comma separated)</label><input type="text" id="autoRoleIds" placeholder="roleId1, roleId2"></div>
          <div class="form-group"><label>Allowed Link Roles (comma separated)</label><input type="text" id="allowedLinkRoles" placeholder="roleId1, roleId2"></div>
        </div>

        <h3>Minigame Config</h3>
        <div class="grid">
          <div class="form-group"><label>Guess Image URL</label><input type="text" id="minigameImage" placeholder="https://..."></div>
          <div class="form-group"><label>Guess Answer</label><input type="text" id="minigameAnswer" placeholder="special week"></div>
        </div>
        
        <h3>Advanced Configs (JSON Format)</h3>
        <div class="grid">
          <div class="form-group"><label>Auto Responder ({"trigger": "reply"})</label><input type="text" id="autoResponder" placeholder='{"hello": "hi!"}'></div>
          <div class="form-group"><label>Reaction Roles ({"msgId_emoji": "roleId"})</label><input type="text" id="reactionRoles" placeholder='{"123_👍": "456"}'></div>
        </div>

        <button type="button" class="btn" onclick="saveSettings()">Save Settings</button>
      </form>
      <div id="statusMsg" style="margin-top: 15px; color: #a8ff78; font-weight: bold;"></div>
    </div>
  </div>

  <script>
    async function loadSettings() {
      const guildId = document.getElementById('serverSelect').value;
      const panel = document.getElementById('settingsPanel');
      if (!guildId) { panel.style.display = 'none'; return; }
      
      panel.style.display = 'block';
      const res = await fetch(`/api/settings/${guildId}`);
      const data = await res.json();
      
      const fields = [
        'welcomeChannelId', 'announceChannelId', 'aiChannelId', 'minigameChannelId',
        'ytTrackId', 'ytChannelId', 'twitterTrackId', 'twitterChannelId', 
        'tiktokTrackId', 'tiktokChannelId', 'minigameImage', 'minigameAnswer'
      ];
      
      fields.forEach(f => document.getElementById(f).value = data[f] || '');
      
      document.getElementById('autoRoleIds').value = data.autoRoleIds ? data.autoRoleIds.join(', ') : '';
      document.getElementById('allowedLinkRoles').value = data.allowedLinkRoles ? data.allowedLinkRoles.join(', ') : '';
      
      document.getElementById('autoResponder').value = data.autoResponder ? JSON.stringify(data.autoResponder) : '';
      document.getElementById('reactionRoles').value = data.reactionRoles ? JSON.stringify(data.reactionRoles) : '';
    }

    async function saveSettings() {
      const guildId = document.getElementById('serverSelect').value;
      if (!guildId) return;

      const body = {
        welcomeChannelId: document.getElementById('welcomeChannelId').value,
        announceChannelId: document.getElementById('announceChannelId').value,
        aiChannelId: document.getElementById('aiChannelId').value,
        minigameChannelId: document.getElementById('minigameChannelId').value,
        ytTrackId: document.getElementById('ytTrackId').value,
        ytChannelId: document.getElementById('ytChannelId').value,
        twitterTrackId: document.getElementById('twitterTrackId').value,
        twitterChannelId: document.getElementById('twitterChannelId').value,
        tiktokTrackId: document.getElementById('tiktokTrackId').value,
        tiktokChannelId: document.getElementById('tiktokChannelId').value,
        minigameImage: document.getElementById('minigameImage').value,
        minigameAnswer: document.getElementById('minigameAnswer').value,
        autoRoleIds: document.getElementById('autoRoleIds').value,
        allowedLinkRoles: document.getElementById('allowedLinkRoles').value,
        autoResponder: document.getElementById('autoResponder').value,
        reactionRoles: document.getElementById('reactionRoles').value,
      };

      const res = await fetch(`/api/settings/${guildId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      
      const resData = await res.json();
      const status = document.getElementById('statusMsg');
      status.innerText = resData.message || 'Saved successfully!';
      setTimeout(() => status.innerText = '', 3000);
    }
  </script>
</body>
</html>

